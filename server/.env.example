# Capgemini Exceller Server Configuration
PORT=5000
NODE_ENV=development

# Paste your MongoDB Atlas connection string below:
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/capgemini_exceller?retryWrites=true&w=majority
MONGODB_URI=

# Allowed Client Origins for CORS (comma separated)
CLIENT_URL=http://localhost:5173,http://localhost:5174

# Firebase Admin SDK Configuration (Server-Side Only - NEVER expose to client)
# Option 1: Individual credentials (recommended for environment variables)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Note: In .env, enter the private key string or escape newlines (e.g. "-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n")
FIREBASE_PRIVATE_KEY=

# Option 2: Path to service account JSON file (alternative)
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
